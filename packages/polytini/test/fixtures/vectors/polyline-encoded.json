    {
      "name": "encoding: simple 2d line",
      "op": "encode",
      "input": [
        [38.5, -120.5],
        [40.7, -120.95],
        [43.252, -126.453]
      ],
      "expected": "_p~iF~cn~U_ulLn{vA_mqNvxq`@"
    },
    {
      "name": "encoding: with precision = 6",
      "op": "encode",
      "input": [
        [38.5, -120.5],
        [40.7, -120.95],
        [43.252, -126.453]
      ],
      "options": 6,
      "expected": "_izlhA~pvydF_{geC~{mZ_kwzCn`{nI"
    },
    {
      "name": "encoding: signed integers with dimension = 1",
      "op": "encode",
      "input": [
        [0],
        [15],
        [14],
        [-2],
        [14],
        [15]
      ],
      "options": {
        "dimensions": 1,
        "precision": 0
      },
      "expected": "?]@^_@A",
      "note": "The source encodes these values one by one with no deltas (encodeSignedIntegers / encodeFloats). polytini with dimensions 1 encodes deltas, so the input here is the running sum of the source values."
    },
    {
      "name": "encoding: floats with dimension = 1",
      "op": "encode",
      "input": [
        [0],
        [0.00015],
        [0.00014],
        [-0.00002],
        [0.00014],
        [0.00015]
      ],
      "options": {
        "dimensions": 1
      },
      "expected": "?]@^_@A",
      "note": "The source encodes these values one by one with no deltas (encodeSignedIntegers / encodeFloats). polytini with dimensions 1 encodes deltas, so the input here is the running sum of the source values."
    },
    {
      "name": "encoding: floats with dimension = 1, factor 1e2",
