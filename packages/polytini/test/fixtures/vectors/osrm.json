  "cases": [
    {
      "name": "polyline5_test_case",
      "op": "encode",
      "input": [
        [-73.990171, 40.714701],
        [-73.991801, 40.717571],
        [-73.985751, 40.715651]
      ],
      "options": {
        "order": "lnglat"
      },
      "expected": "{aowFperbM}PdI~Jyd@",
      "note": "OSRM coordinates are (lon, lat), so these cases use order lnglat."
    },
    {
      "name": "polyline5_test_case: decode",
      "op": "decode",
      "input": "{aowFperbM}PdI~Jyd@",
      "options": {
        "order": "lnglat"
      },
      "expected": [
        [-73.99017, 40.7147],
        [-73.9918, 40.71757],
        [-73.98575, 40.71565]
      ],
      "note": "The source expects coords_truncated (six-digit values ending in 0)."
    },
    {
      "name": "polyline6_test_case",
      "op": "encode",
      "input": [
        [-73.990171, 40.714701],
        [-73.991801, 40.717571],
        [-73.985751, 40.715651]
      ],
      "options": {
        "precision": 6,
        "order": "lnglat"
      },
      "expected": "y{_tlAt`_clCkrDzdB~vBcyJ"
    },
    {
      "name": "polyline6_test_case: decode",
      "op": "decode",
      "input": "y{_tlAt`_clCkrDzdB~vBcyJ",
      "options": {
        "precision": 6,
        "order": "lnglat"
      },
      "expected": [
        [-73.990171, 40.714701],
        [-73.991801, 40.717571],
        [-73.985751, 40.715651]
      ]
    },
    {
      "name": "empty_polyline_test",
      "op": "encode",
      "input": [],
      "options": {
        "order": "lnglat"
      },
      "expected": ""
    },
    {
      "name": "empty_polyline_test: decode",
      "op": "decode",
      "input": "",
      "options": {
        "order": "lnglat"
      },
      "expected": []
    },
    {
      "name": "polyline_single_point_test",
      "op": "encode",
      "input": [
        [-122.414, 37.776]
      ],
      "options": {
        "order": "lnglat"
      },
      "expected": "_cqeFn~cjV"
    },
    {
      "name": "polyline_single_point_test: decode",
      "op": "decode",
      "input": "_cqeFn~cjV",
      "options": {
        "order": "lnglat"
      },
      "expected": [
        [-122.414, 37.776]
      ]
    },
    {
      "name": "polyline_multiple_points_test",
      "op": "encode",
      "input": [
        [-122.414, 37.776],
        [-122.42, 37.779],
        [-122.421, 37.78]
      ],
      "options": {
        "order": "lnglat"
      },
      "expected": "_cqeFn~cjVwQnd@gEfE"
    },
    {
      "name": "polyline_multiple_points_test: decode",
      "op": "decode",
      "input": "_cqeFn~cjVwQnd@gEfE",
      "options": {
        "order": "lnglat"
      },
      "expected": [
        [-122.414, 37.776],
        [-122.42, 37.779],
        [-122.421, 37.78]
      ]
    },
    {
      "name": "polyline_large_coordinate_difference_test",
      "op": "encode",
      "input": [
        [-179, -89],
        [179, 89]
      ],
      "options": {
        "order": "lnglat"
      },
      "expected": "~xe~O~|oca@_sl}`@_{`hcA"
    },
    {
      "name": "polyline_large_coordinate_difference_test: decode",
      "op": "decode",
      "input": "~xe~O~|oca@_sl}`@_{`hcA",
      "options": {
        "order": "lnglat"
      },
      "expected": [
        [-179, -89],
        [179, 89]
      ]
    },
