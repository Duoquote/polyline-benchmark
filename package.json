{
  "name": "polyline-benchmark",
  "private": true,
  "description": "Correctness checks and benchmarks for JavaScript implementations of the Google encoded polyline format",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/correctness.js",
    "test:bun": "bun test/correctness.js",
    "test:deno": "deno run --allow-read test/correctness.js",
    "behavior": "node test/behavior.js",
    "bench": "node --expose-gc bench/run.js",
    "bench:bun": "bun bench/run.js",
    "bench:deno": "deno run --allow-read --allow-write --allow-sys --allow-env --allow-run --v8-flags=--expose-gc bench/run.js",
    "bench:browser": "node bench/browser.js",
    "bench:flexible": "node --expose-gc bench/run.js --format flexible",
    "bench:all": "node bench/matrix.js",
    "size": "node bench/size.js",
    "bench:quick": "node bench/matrix.js --quick",
    "charts": "node bench/charts.js",
    "memory": "node --expose-gc --max-semi-space-size=128 bench/memory.js"
  },
  "dependencies": {
    "@duoquote/polytini": "0.1.4",
    "@googlemaps/polyline-codec": "1.0.28",
    "@here/flexpolyline": "0.1.0",
    "@lp-labs/polyline-codec": "0.1.0",
    "@mapbox/polyline": "1.2.1",
    "@pirxpilot/google-polyline": "4.0.1",
    "@placemarkio/polyline": "2.0.3",
    "decode-google-map-polyline": "1.0.1",
    "google-polyline": "2.0.0",
    "ol": "10.11.0",
    "polyline-encoded": "0.0.9"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "tinybench": "6.2.5"
  }
}
